# Root env — used by migration/verify scripts and Python test scripts (reads ../.env if present).
# Fill these in and also create frontend/.env and backend/.env for the apps.

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ANON_KEY=your_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ACCESS_TOKEN=your_management_api_personal_access_token

# Backend env (used by backend/.env)
PORT=4000
CLIENT_ORIGIN=http://localhost:5173